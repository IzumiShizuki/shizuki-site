# Minimal server-side compose env for shizuki-site.
# Copy to deploy/.env.server and adjust values for your server.

SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
BACKEND_PORT=8080
SITE_PORT=5173

# Frontend build-time settings. Changes require rebuilding the `site` image.
VITE_GATEWAY_BASE_URL=/
VITE_METING_CONSOLE_URL=
# Required by the tldraw SDK for HTTPS production deployments.
# Put the issued public, domain-bound key in deploy/.env.server only.
VITE_TLDRAW_LICENSE_KEY=

# Optional AI chat overrides.
AI_CHAT_ENABLED=false
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=cpa-gpt-5.4-mini

# Meguri website gateway (owner-only /meguri page).
# The token must equal the shared token accepted by the remote meguri-core
# (same secret the desktop pet gateway uses). Keep it out of Git.
MEGURI_GATEWAY_ENABLED=false
MEGURI_CORE_BASE_URL=https://bot.shizuki.online/meguri-core
MEGURI_CORE_TOKEN=
MEGURI_TENANT_ID=meguri-staging
MEGURI_OWNER_USER_ID=local-airi-user
MEGURI_FORMAL_MEMORY_ALLOWED=false
# Host directory mounted read-only into the backend at
# /app/meguri-assets/sprites. Copy meguri-pet's data/meguri/assets/sprites/meguri
# folder under it, so PNGs live at <host-dir>/meguri/ce04001l.png.
MEGURI_SPRITE_HOST_DIR=/opt/shizuki-site/data/meguri-assets/sprites
MEGURI_DEFAULT_SPRITE=ce04001l.png

# Atmosphere panel online ambience library (Freesound).
# Free token: https://freesound.org/apiv2/apply  (copy the "Api key" column,
# NOT the client id). Leave empty to hide the panel's online library tab.
MUSIC_FREESOUND_API_KEY=

# Blog sidecars.
PRESENTATION_GENERATOR_PORT=3210
VIDEO_CONVERTER_PORT=3220

# Light-app balance bill sync sidecar.
BILL_SYNC_AGENT_PORT=39031
BILL_SYNC_AGENT_TOKEN=
BILL_SYNC_AGENT_HEADLESS=true
BILL_SYNC_AGENT_BROWSER_PATH=
BILL_SYNC_AGENT_TIMEOUT_MS=45000
BILL_SYNC_AGENT_NAV_TIMEOUT_MS=60000
BILL_SYNC_AGENT_TIMEZONE=Asia/Shanghai
BILL_SYNC_AGENT_ALIPAY_LOGIN_URL=
BILL_SYNC_AGENT_ALIPAY_BILL_URL=
BILL_SYNC_AGENT_DATA_DIR=/opt/shizuki-site/data/bill-sync-agent
BILL_SYNC_AGENT_WECHAT_BILL_DIR=/data/wechat-bills
BILL_SYNC_AGENT_BANKCARD_BILL_DIR=/data/bankcard-bills

# Notion MCP sidecar.
NOTION_MCP_PORT=39051
NOTION_MCP_ENDPOINT_PATH=/mcp/notion
NOTION_MCP_HEALTH_PATH=/healthz
NOTION_MCP_PREFERRED_SOURCE=blog
# Generate once: openssl rand -base64 32
NOTION_MCP_SERVER_TOKEN=

# Backend uses this via resouces/yaml/common-config.yaml placeholder.
# Generate once: openssl rand -base64 32
BALANCE_STORAGE_STATE_ENCRYPTION_KEY=<GENERATE_BASE64_32_BYTES>

# Admin Server Ops (web admin -> Server Ops tab).
# Mutations (start/stop/restart) stay guarded by ADMIN login + privilege unlock.
ADMIN_OPS_ENABLE_MUTATIONS=true
# Comma-separated container names the web admin may start/stop/restart.
#ADMIN_OPS_ALLOWED_CONTAINERS=meguri-pet,shizuki-memoryos,shizuki-site-backend,shizuki-site-frontend,shizuki-site-meting-api,shizuki-site-music-ncm-api,shizuki-site-music-web-auth-sidecar,shizuki-site-presentation-generator,shizuki-site-bill-sync-agent,shizuki-site-document-converter
# Meguri Pet container name on this host (defaults to meguri-pet).
#MEGURI_PET_CONTAINER_NAME=meguri-pet
# Optional HTTP health endpoint of Meguri Pet, reachable from the backend
# container (e.g. http://host.docker.internal:PORT/health). Empty = skip probe.
MEGURI_PET_HEALTH_URL=
# MemoryOS health probe (host port published by docker-compose.memoryos.yml).
#MEMORYOS_HEALTH_URL=http://host.docker.internal:8788/health
# Container log viewer defaults.
#ADMIN_OPS_LOGS_TAIL_LINES=200
#ADMIN_OPS_LOGS_MAX_TAIL_LINES=1000

# Wallpaper acquire: embedded discovery + Steam Workshop real download.
# See deploy/WALLPAPER_WORKSHOP_STEAMCMD.md for the full setup guide.
WALLPAPER_DISCOVERY_ENABLED=true
# Optional authenticated HTTP proxy for Steam/Wallhaven discovery only.
# Percent-encode reserved characters in proxy credentials.
WALLPAPER_DISCOVERY_PROXY_URL=
# Required for a Basic-authenticated HTTP proxy used with HTTPS upstreams.
WALLPAPER_DISCOVERY_JDK_JAVA_OPTIONS=-Djdk.http.auth.tunneling.disabledSchemes=
# Optional Steam Web API key (https://steamcommunity.com/dev/apikey).
# With a key, workshop search uses the official API instead of page scraping.
WALLPAPER_STEAM_API_KEY=
# Enable SteamCMD download channel (requires a Steam account that owns Wallpaper Engine).
WALLPAPER_WORKSHOP_ENABLED=false
WALLPAPER_STEAMCMD_PATH=/opt/steamcmd/steamcmd.sh
WALLPAPER_STEAM_USERNAME=
WALLPAPER_STEAM_PASSWORD=
WALLPAPER_WORKSHOP_DOWNLOAD_ROOT=/data/steam-workshop
WALLPAPER_WORKSHOP_TIMEOUT_SECONDS=600
# Optional mirrors if steamcommunity.com / wallhaven.cc are unreachable from the server.
WALLPAPER_WORKSHOP_BROWSE_BASE_URL=https://steamcommunity.com
WALLPAPER_WALLHAVEN_BASE_URL=https://wallhaven.cc
WALLPAPER_WALLHAVEN_API_KEY=
