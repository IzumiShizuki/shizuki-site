+function relayEmbeddedProgressSeek(positionSec: number): void {
+  const now = performance.now();
+  const unchanged = Math.abs(positionSec - lastFollowSeekPositionSec) < 0.05;
+  if (unchanged && now - lastFollowSeekAt < 45) return;
