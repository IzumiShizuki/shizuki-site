+  lastFollowSeekPositionSec = positionSec;
+  lastFollowSeekAt = now;
+  syncFollowClock(Math.round(positionSec * 1000), followClockPlaying);
+  postToParent({
+    type: 'shizuki:playback-command',
+    action: 'seek',
+    positionMs: Math.round(positionSec * 1000),
+  });
