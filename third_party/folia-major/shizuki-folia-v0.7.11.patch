+    version,
+    track,
+    queue,
+    playlist,
+    lyrics,
+    lyricRenderMode: String(data.lyricRenderMode || 'original'),
+    lyricIndex: Number.isInteger(Number(data.lyricIndex)) ? Number(data.lyricIndex) : -1,
