+describe('same-document Folia playback bridge', () => {
+  afterEach(() => {
+    vi.restoreAllMocks();
+    vi.unstubAllGlobals();
+    usePlaybackStore.setState({
+      currentSong: null,
+      audioSrc: null,
+      lyrics: null,
+      duration: 0,
+      playerState: PlayerState.IDLE,
+      currentLineIndex: -1,
+      playQueue: [],
+    });
