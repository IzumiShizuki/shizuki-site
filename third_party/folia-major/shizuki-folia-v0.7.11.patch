+    lines,
+    title: String(song?.name || ''),
+    artist,
+    isWordByWord: rows.some((entry) => entry.words.length > 0),
+  };
+}
+
+function buildFollowLyricsFingerprint(
+  rawLyrics: unknown,
+  song: SongResult | null,
+  durationMs: number,
+): string {
+  const artists = Array.isArray(song?.artists)
