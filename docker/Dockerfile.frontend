FROM m.daocloud.io/docker.io/library/node:24-alpine AS build
WORKDIR /app/fronted/vue3-merged

COPY fronted/vue3-merged/package.json \
     fronted/vue3-merged/pnpm-lock.yaml \
     fronted/vue3-merged/pnpm-workspace.yaml ./
RUN corepack enable \
    && corepack prepare pnpm@11.8.0 --activate \
    && pnpm config set registry https://registry.npmmirror.com \
    && pnpm install --frozen-lockfile

COPY fronted/vue3-merged/ ./

# Use "/" to make frontend call same-origin /api paths.
ARG VITE_GATEWAY_BASE_URL=/
ENV VITE_GATEWAY_BASE_URL=${VITE_GATEWAY_BASE_URL}
ARG VITE_METING_CONSOLE_URL=
ENV VITE_METING_CONSOLE_URL=${VITE_METING_CONSOLE_URL}
ARG VITE_TLDRAW_LICENSE_KEY=
ENV VITE_TLDRAW_LICENSE_KEY=${VITE_TLDRAW_LICENSE_KEY}

RUN pnpm build

FROM m.daocloud.io/docker.io/library/nginx:1.27-alpine AS runtime
COPY deploy/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/fronted/vue3-merged/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
